              <divide/>
              <apply>
                <plus/>
                <apply>
                  <minus/>
                  <apply><exp/><apply><times/><cn>0.5</cn><ci>h</ci></apply></apply>
                </apply>
                <apply><exp/><apply><minus/><apply><times/><ci>h</ci><ci>w_clk1</ci></apply></apply></apply>
              </apply>
              <apply>
                <times/>
                <apply>
                  <minus/>
                  <cn>1</cn>
                  <apply><exp/><apply><times/><cn>0.5</cn><ci>h</ci></apply></apply>
                </apply>
                <apply>
                  <plus/>
                  <cn>1</cn>
                  <apply><exp/><apply><minus/><apply><times/><ci>h</ci><apply><minus/><ci>w_clk1</ci><cn>0.5</cn></apply></apply></apply></apply>
                </apply>
              </apply>
            </apply>
            <!-- Decay term: alpha * X -->
            <apply>
              <times/>
              <ci>alphaclk1</ci>
